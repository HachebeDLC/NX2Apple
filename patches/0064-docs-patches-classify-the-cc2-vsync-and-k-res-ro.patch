+    ('k_res', '', '', {'what': "the game's display-mode rows rewritten for the profile's display_height (STORM CONNECTIONS)", 'now': 'build', 'goal': 'game', 'purpose': 'resolution',
+     'why': "the game picks its output size from its own mode table; the host rewrites two rows so 900 / 1080 exist"}),
