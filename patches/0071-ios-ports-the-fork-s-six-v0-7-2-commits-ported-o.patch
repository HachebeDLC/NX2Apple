+    if (getenv("DM_HEAPTRACK_POISON")) { g_hts_k = calloc(HT_SCAP, 8); g_hts_v = calloc(HT_SCAP, 8); g_hts_lr = calloc(HT_SCAP, 32); g_hl = calloc(1u << 21, sizeof *g_hl); g_hl_idx = calloc(HT_SCAP, 4); }
