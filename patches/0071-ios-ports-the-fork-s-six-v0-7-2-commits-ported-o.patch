+        if (*p == '/') { p++; if (*p == 'x') p++; reg = (int)strtol(p, (char **)&p, 10); }
+        if (*p == '/') { p++; if (*p == 'x') p++; oreg = (int)strtol(p, (char **)&p, 10); }
+        g_hts[g_nhts++] = (ht_site){(uint64_t)m->base + off, kind, reg, oreg};
+        probe_add(m, off, -1, ht_hit);
+        while (*p == ',') p++;
+    }
+    LOG("DM_HEAPTRACK: %d sites", g_nhts);
+}
